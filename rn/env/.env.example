# 환경 파일 양식 — env/.env.development 와 env/.env.production 으로 복사해 사용
# 빌드 시 자동 선택:
#   - Android: ./gradlew assembleDevDebug   ← env/.env.development
#             ./gradlew assembleProdRelease ← env/.env.production
#   - iOS:    yarn ios:dev / yarn ios:prod  (root `.env` 로 cp 후 빌드)

APP_ENV=DEVELOPMENT
USE_MOCK=true                         # mock 데모 모드 토글
API_SERVER=https://api.example.com

# OAuth — mock 모드에서는 미사용
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_CLIENT_ID_ANDROID=
APPLE_REDIRECT_URI=

# 문의 메일
EMAIL_ADDRESS=demo@example.com

# Sentry — mock 모드에서는 미사용
SENTRY_DSN=
