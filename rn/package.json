    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-transform-remove-console": "^6.9",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
