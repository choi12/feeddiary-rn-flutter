{
  "name": "feedDiary",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "yarn android:dev",
    "android:dev": "react-native run-android --mode=devDebug --appIdSuffix=dev",
    "android:prod": "react-native run-android --mode=prodRelease",
    "ios": "yarn ios:dev",
    "ios:dev": "echo 'env/.env.development' > /tmp/envfile && react-native run-ios --scheme feedDiary-dev --mode Debug.dev",
    "ios:prod": "echo 'env/.env.production' > /tmp/envfile && react-native run-ios --scheme feedDiary-prod --mode Debug",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@choi12/rn-basic-calendar": "^0.1.10",
