    "@react-navigation/bottom-tabs": "^7",
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "@sentry/react-native": "^8",
    "@tanstack/react-query": "^5.52",
    "axios": "^1.7",
    "axios-mock-adapter": "^2",
    "expo": "~56.0.0",
    "expo-image": "^56",
    "jwt-decode": "^4",
    "lottie-react-native": "^7",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-bootsplash": "^7.3.1",
    "react-native-config": "^1.5",
